<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="HITSight Agent"
           Language="1033"
           Version="1.0.22"
           Manufacturer="HackIT"
           UpgradeCode="A7F34C2E-8B91-4D56-9E32-1A5C8F720E3D">

    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version von HITSight Agent ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Hide from Programs & Features / Add-Remove-Programs -->
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />

    <!-- Properties set via msiexec: SERVERURL="..." DEPLOYKEY="..." -->
    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="DEPLOYKEY" Secure="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="HITSight">
          <Directory Id="AGENTFOLDER" Name="Agent">

            <Component Id="AgentExe" Guid="*" Win64="yes">
              <File Id="AgentExeFile" Source="files/HITSight.Agent.exe" KeyPath="yes" />
              <ServiceInstall Id="AgentService"
                  Name="HITSightAgent"
                  DisplayName="HITSight Agent"
                  Description="HITSight Device Management Agent"
                  Type="ownProcess"
                  Start="auto"
                  ErrorControl="normal"
                  Interactive="no" />
              <ServiceControl Id="AgentServiceControl"
                  Name="HITSightAgent"
                  Start="install"
                  Stop="both"
                  Remove="uninstall"
                  Wait="yes" />
            </Component>

            <Component Id="AppSettings" Guid="*" Win64="yes">
              <File Id="AppSettingsFile" Source="files/appsettings.json" KeyPath="yes" />
            </Component>

          </Directory>

          <!-- Registry: server URL and deploy key (read by agent on startup) -->
          <Component Id="RegistryConfig" Guid="*" Win64="yes">
            <RegistryKey Root="HKLM" Key="SOFTWARE\HITSight" Action="createAndRemoveOnUninstall">
              <RegistryValue Name="ServerUrl" Type="string" Value="[SERVERURL]" KeyPath="yes" />
              <RegistryValue Name="DeployKey" Type="string" Value="[DEPLOYKEY]" />
            </RegistryKey>
          </Component>

        </Directory>
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Level="1">
      <ComponentRef Id="AgentExe" />
      <ComponentRef Id="AppSettings" />
      <ComponentRef Id="RegistryConfig" />
    </Feature>

  </Product>
</Wix>
