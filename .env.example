# HackIT Sentry – Environment Variables
# Copy this file to .env and fill in real values before deploying.
# Run: cp .env.example .env && ./setup.sh   (setup.sh generates random secrets)

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-in-production

# ── JWT signing key (minimum 32 characters) ───────────────────────────────────
JWT_KEY=change-this-secret-in-production-must-be-at-least-32-chars!!

# ── AES-256 encryption key for stored license/product keys (32 characters) ───
ENCRYPTION_KEY=change-this-aes-key-in-production-32chars!!

# ── Agent check-in interval (minutes) ────────────────────────────────────────
CHECKIN_INTERVAL_MINUTES=30

# ── Outpost public URL (required for installer download & email links) ────────
# Must point to the outpost container as reachable from outside.
# Example: http://192.168.1.100:8031  or  https://sentry.example.com
OUTPOST_PUBLIC_URL=

# ── E-Mail Alerting (optional – leave EMAIL_HOST empty to disable) ────────────
# Sends an alert when a device goes offline or comes back online.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=sentry@example.com
EMAIL_TO=admin@example.com
EMAIL_USE_SSL=false

# ── RustDesk self-hosted relay (optional) ─────────────────────────────────────
# Public hostname or IP of this server (without port).
# Leave empty to run the relay without distributing it to agents.
# Example: 192.168.1.100  or  sentry.example.com
RUSTDESK_PUBLIC_HOST=
